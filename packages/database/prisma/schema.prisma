generator client {
  provider        = "prisma-client"
  engineType      = "client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  runtime         = "nodejs"
  previewFeatures = ["postgresqlExtensions", "relationJoins", "views"]
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
  extensions   = []
}

model tenants {
  id         String    @id @db.Uuid
  name       String
  created_at DateTime  @db.Timestamptz()
  created_by String
  updated_at DateTime? @db.Timestamptz()
  updated_by String?
}

model contacts {
  id         String    @id @db.Uuid
  tenant_id  String    @db.Uuid
  email      String
  first_name String?
  last_name  String?
  created_at DateTime  @db.Timestamptz()
  created_by String
  updated_at DateTime? @db.Timestamptz()
  updated_by String?

  activities   activities[]
  bounces      bounces[]
  subscribers  subscribers[]
  unsubscribes unsubscribes[]
  mail_logs    mail_logs[]

  @@unique([tenant_id, email])
}

enum campaign_status {
  Active
  Scheduled
  Completed
  Draft
  Paused
  Cancelled
}

enum campaign_type {
  OneTime
  Automated
}

model campaigns {
  id            String          @id @db.Uuid
  tenant_id     String          @db.Uuid
  name          String
  status        campaign_status
  type          campaign_type
  recipients    Int
  sent          Int
  delivered     Int
  scheduled_for DateTime?       @db.Timestamptz()
  created_at    DateTime        @db.Timestamptz()
  created_by    String
  updated_at    DateTime?       @db.Timestamptz()
  updated_by    String?

  activities activities[]

  @@unique([tenant_id, name])
}

enum activity_status {
  Delivered
  Opened
  Clicked
  Pending
  Scheduled
  Bounced
  Failed
}

enum event_type {
  Queued
  Delivered
  Clicked
  Opened
  Failed
  Bounced
}

model activities {
  id                     String          @id @db.Uuid
  tenant_id              String          @db.Uuid
  send_name              String
  subject                String
  status                 activity_status
  sent_at                DateTime        @db.Timestamptz()
  last_event_received_at DateTime        @db.Timestamptz()
  last_event_type        event_type
  opens                  Int
  clicks                 Int
  campaign_id            String?         @db.Uuid
  contact_id             String          @db.Uuid
  created_at             DateTime        @db.Timestamptz()
  created_by             String
  updated_at             DateTime?       @db.Timestamptz()
  updated_by             String?

  receivers contacts   @relation(fields: [contact_id], references: [id])
  campaigns campaigns? @relation(fields: [campaign_id], references: [id])

  @@index([tenant_id, contact_id, campaign_id])
}

enum bounce_type {
  Hard
  Soft
}

model bounces {
  id          String      @id @db.Uuid
  tenant_id   String      @db.Uuid
  bounced_at  DateTime    @db.Timestamptz()
  reason      String
  bounce_type bounce_type
  contact_id  String      @db.Uuid
  created_at  DateTime    @db.Timestamptz()
  created_by  String
  updated_at  DateTime?   @db.Timestamptz()
  updated_by  String?

  contacts contacts @relation(fields: [contact_id], references: [id])

  @@unique([tenant_id, contact_id])
}

enum subscriber_status {
  Subscribed
  Unsubscribed
  Bounced
  Complaint
}

model subscribers {
  id                 String            @id @db.Uuid
  tenant_id          String            @db.Uuid
  status             subscriber_status
  subscribed_at      DateTime          @db.Timestamptz()
  subscriber_list_id String            @db.Uuid
  contact_id         String            @db.Uuid
  created_at         DateTime          @db.Timestamptz()
  created_by         String
  updated_at         DateTime?         @db.Timestamptz()
  updated_by         String?

  contacts         contacts         @relation(fields: [contact_id], references: [id])
  subscriber_lists subscriber_lists @relation(fields: [subscriber_list_id], references: [id])

  @@unique([tenant_id, contact_id, subscriber_list_id])
}

model subscriber_lists {
  id          String    @id @db.Uuid
  tenant_id   String    @db.Uuid
  name        String
  description String?
  created_at  DateTime  @db.Timestamptz()
  created_by  String
  updated_at  DateTime? @db.Timestamptz()
  updated_by  String?

  subscribers   subscribers[]
  mail_sendings mail_sendings_on_subscriber_lists[]

  @@unique([tenant_id, name])
}

enum unsubscribe_source {
  UnsubscribeLink
  ManualAddition
  Bounce
  Api
  Other
}

model unsubscribes {
  id              String             @id @db.Uuid
  tenant_id       String             @db.Uuid
  source          unsubscribe_source
  unsubscribed_at DateTime           @db.Timestamptz()
  global          Boolean
  list_ids        String[]           @db.Uuid
  contact_id      String             @db.Uuid
  created_at      DateTime           @db.Timestamptz()
  created_by      String
  updated_at      DateTime?          @db.Timestamptz()
  updated_by      String?

  contacts contacts @relation(fields: [contact_id], references: [id])

  @@unique([tenant_id, contact_id])
}

model users {
  id                 String    @id @db.Uuid
  tenant_id          String    @db.Uuid
  email              String
  first_name         String?
  last_name          String?
  role_id            String    @db.Uuid
  active             Boolean
  last_login_at      DateTime? @db.Timestamptz()
  permissions        String[]
  email_verified     Boolean   @default(false)
  image              String?
  two_factor_enabled Boolean?
  created_at         DateTime  @db.Timestamptz()
  created_by         String
  updated_at         DateTime? @db.Timestamptz()
  updated_by         String?

  roles roles @relation(fields: [role_id], references: [id])

  accounts    accounts[]
  two_factors two_factors[]
  passkeys    passkeys[]
  sessions    sessions[]

  @@unique([email])
  @@index([tenant_id])
}

model api_keys {
  id           String    @id @db.Uuid
  tenant_id    String    @db.Uuid
  name         String
  key          String
  active       Boolean
  last_used_at DateTime? @db.Timestamptz()
  expires_at   DateTime? @db.Timestamptz()
  permissions  String[]
  created_at   DateTime  @db.Timestamptz()
  created_by   String
  updated_at   DateTime? @db.Timestamptz()
  updated_by   String?

  @@unique([key])
  @@index([tenant_id])
}

model template_properties {
  id            String  @id @db.Uuid
  tenant_id     String  @db.Uuid
  templates_id  String? @db.Uuid
  name          String
  type          String
  default_value Json

  templates templates? @relation(fields: [templates_id], references: [id])

  @@index([tenant_id])
}

model templates {
  id          String                @id @db.Uuid
  tenant_id   String                @db.Uuid
  name        String
  description String?
  content     String
  properties  template_properties[]
  created_at  DateTime              @db.Timestamptz()
  created_by  String
  updated_at  DateTime?             @db.Timestamptz()
  updated_by  String?

  @@index([tenant_id])
}

model contact_imports {
  id         String    @id @db.Uuid
  tenant_id  String    @db.Uuid
  name       String?
  filename   String
  status     Float
  records    Int
  finished   Boolean
  parameters Json      @db.JsonB
  created_at DateTime  @db.Timestamptz()
  created_by String
  updated_at DateTime? @db.Timestamptz()
  updated_by String?

  @@index([tenant_id])
}

model files {
  id         String    @id @db.Uuid
  tenant_id  String    @db.Uuid
  name       String
  data       Bytes     @db.ByteA
  created_at DateTime  @db.Timestamptz()
  created_by String
  updated_at DateTime? @db.Timestamptz()
  updated_by String?

  @@index([tenant_id])
}

model accounts {
  id                       String    @id @db.Uuid
  user_id                  String    @db.Uuid
  account_id               String    @db.Uuid
  provider_id              String
  access_token             String?
  refresh_token            String?
  access_token_expires_at  DateTime? @db.Timestamptz()
  refresh_token_expires_at DateTime? @db.Timestamptz()
  scope                    String?
  id_token                 String?
  password                 String?
  created_at               DateTime  @db.Timestamptz()
  created_by               String
  updated_at               DateTime? @db.Timestamptz()
  updated_by               String?

  users users? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([provider_id, account_id])
  @@index([access_token])
}

model verifications {
  id         String    @id @db.Uuid
  identifier String
  value      String
  expires_at DateTime  @db.Timestamptz()
  created_at DateTime  @db.Timestamptz()
  created_by String
  updated_at DateTime? @db.Timestamptz()
  updated_by String?
}

model two_factors {
  id           String   @id @db.Uuid
  user_id      String   @db.Uuid
  secret       String?
  backup_codes String?
  created_at   DateTime @db.Timestamptz()
  created_by   String

  users users? @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model passkeys {
  id            String   @id @db.Uuid
  name          String?
  public_key    String
  user_id       String   @db.Uuid
  credential_id String
  counter       Float
  device_type   String
  backed_up     Boolean
  transports    String
  aaguid        String?
  created_at    DateTime @db.Timestamptz()
  created_by    String

  users users? @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model sessions {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  token      String
  expires_at DateTime  @db.Timestamptz()
  ip_address String?
  user_agent String?
  created_at DateTime  @db.Timestamptz()
  created_by String
  updated_at DateTime? @db.Timestamptz()
  updated_by String?

  users users? @relation(fields: [user_id], references: [id])

  @@unique([token])
  @@index([user_id])
}

model roles {
  id          String    @id @db.Uuid
  tenant_id   String    @db.Uuid
  name        String
  description String?
  permissions String[]
  created_at  DateTime  @db.Timestamptz()
  created_by  String
  updated_at  DateTime? @db.Timestamptz()
  updated_by  String?

  users users[]

  @@unique([tenant_id, name])
}

model mail_configs {
  id         String    @id @db.Uuid
  tenant_id  String    @db.Uuid
  name       String
  type       String
  config     Json      @db.JsonB
  created_at DateTime  @db.Timestamptz()
  created_by String
  updated_at DateTime? @db.Timestamptz()
  updated_by String?

  webhooks      webhooks[]
  mail_sendings mail_sendings[]

  @@index([tenant_id])
}

enum mail_log_status {
  Delivered
  Pending
  Scheduled
  Bounced
  Failed
}

model mail_logs {
  id               String          @id @db.Uuid
  tenant_id        String          @db.Uuid
  contact_id       String?         @db.Uuid
  provider_id      String
  provider_mail_id String
  opens            Int
  clicks           Int
  status           mail_log_status
  created_at       DateTime        @db.Timestamptz()
  created_by       String
  updated_at       DateTime?       @db.Timestamptz()
  updated_by       String?

  contacts contacts? @relation(fields: [contact_id], references: [id])

  @@unique([provider_id, provider_mail_id])
  @@index([tenant_id])
}

model webhooks {
  id             String @id @db.Uuid
  tenant_id      String @db.Uuid
  mail_config_id String @db.Uuid
  provider_id    String

  mail_config mail_configs @relation(fields: [mail_config_id], references: [id])
}

model mail_sendings {
  id             String   @id @db.Uuid
  tenant_id      String   @db.Uuid
  mail_sender_id String   @db.Uuid
  mail_config_id String   @db.Uuid
  subject        String
  content_type   String
  content        String?
  text_content   String?
  template_id    String?  @db.Uuid
  is_template    Boolean
  substitutions  Json     @db.JsonB
  created_at     DateTime @db.Timestamptz()
  created_by     String

  mail_sender mail_senders @relation(fields: [mail_sender_id], references: [id])
  mail_config mail_configs @relation(fields: [mail_config_id], references: [id])

  subscriber_lists mail_sendings_on_subscriber_lists[]
  mail_receivers   mail_sending_receivers[]

  @@index([tenant_id])
}

model mail_sendings_on_subscriber_lists {
  mail_sendings_id   String @db.Uuid
  subscriber_list_id String @db.Uuid

  mail_sendings    mail_sendings    @relation(fields: [mail_sendings_id], references: [id])
  subscriber_lists subscriber_lists @relation(fields: [subscriber_list_id], references: [id])

  @@id([mail_sendings_id, subscriber_list_id])
}

model mail_url_proxies {
  id         String  @id @db.Uuid
  tenant_id  String  @db.Uuid
  contact_id String? @db.Uuid
  position   Int
  from       String
  to         String

  @@index([tenant_id, contact_id])
}

model mail_senders {
  id         String    @id @db.Uuid
  tenant_id  String    @db.Uuid
  name       String
  email      String
  created_at DateTime  @db.Timestamptz()
  created_by String
  updated_at DateTime? @db.Timestamptz()
  updated_by String?

  mail_sendings mail_sendings[]

  @@index([tenant_id])
}

model mail_sending_receivers {
  id              String   @id @db.Uuid
  tenant_id       String   @db.Uuid
  mail_sending_id String   @db.Uuid
  email           String
  name            String
  substitutions   Json     @db.JsonB
  created_at      DateTime @db.Timestamptz()
  created_by      String

  mail_sendings mail_sendings @relation(fields: [mail_sending_id], references: [id])

  @@index([tenant_id])
}

model system_configs {
  key   String @id
  value Json   @db.JsonB
}

view contacts_with_subscriptions {
  id            String    @db.Uuid
  tenant_id     String    @db.Uuid
  email         String
  first_name    String?
  last_name     String?
  created_at    DateTime  @db.Timestamptz()
  created_by    String
  updated_at    DateTime? @db.Timestamptz()
  updated_by    String?
  subscriptions String[]  @db.Uuid
  bounces       Int
  unsubscribes  Int
}
