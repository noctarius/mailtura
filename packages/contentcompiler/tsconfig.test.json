{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "emitDecoratorMetadata": false,
    "composite": false,
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@mailtura/rpcmodel/*": ["../rpcmodel/src/*"]
    }
  },
  "include": ["test/**/*.ts"]
}
