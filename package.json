{
  "name": "mailtura-base",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "@eslint/js": "^9.9.1",
      "@temporalio/activity": "^1.13.2",
      "@temporalio/client": "^1.13.2",
      "@temporalio/proto": "^1.13.2",
      "@temporalio/worker": "^1.13.2",
      "@temporalio/workflow": "^1.13.2",
      "@types/jest": "^30.0.0",
      "better-auth": "^1.4.3",
      "eslint": "^9.9.1",
      "eslint-config-prettier": "^10.1.8",
      "jest": "^29.7.0",
      "papaparse": "^5.5.3",
      "prettier": "^3.6.2",
      "ts-jest": "^29.4.6",
      "typebox": "^1.0.30",
      "typescript": "5.9.3",
      "typescript-eslint": "^8.45.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.49.0"
  },
  "scripts": {
    "build": "bun run --workspaces build",
    "build-libs": "bun run --workspaces build --filter='./packages/rpcmodel' --filter='./packages/database' --filter='./packages/contentcompiler'",
    "lint": "bun run --workspaces lint",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun run --workspaces test"
  },
  "overrides": {
    "glob": "^10.5.0",
    "js-yaml": "^4.1.1"
  }
}
